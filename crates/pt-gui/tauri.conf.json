{
  "$schema": "https://schema.tauri.app/config/2/schema.json",
  "productName": "proton-trainer",
  "version": "1.0.1",
  "identifier": "io.github.zehelh.proton-trainer",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "proton-trainer",
        "width": 940,
        "height": 640,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png"]
  }
}
