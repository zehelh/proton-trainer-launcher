# Maintainer: set your handle when publishing.
# Contributor: set when publishing.
pkgname=proton-trainer
pkgver=0.1.0
pkgrel=1
pkgdesc="Memory trainer for single-player Steam games running under Proton"
arch=('x86_64')
url="https://github.com/zehelh/proton-trainer-launcher"
license=('MIT')
depends=('gcc-libs' 'gtk3' 'webkit2gtk-4.1')
makedepends=('cargo')
_url_archive="https://github.com/zehelh/proton-trainer-launcher"
source=("${_url_archive}/archive/refs/tags/v${pkgver}.tar.gz")
# The sha256 is refreshed by the release process (makepkg -g).
sha256sums=('SKIP')

prepare() {
    cd "${srcdir}/proton-trainer-launcher-${pkgver}"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "${CARCH}-unknown-linux-gnu"
}

build() {
    cd "${srcdir}/proton-trainer-launcher-${pkgver}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --release --frozen
}

check() {
    cd "${srcdir}/proton-trainer-launcher-${pkgver}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --release --frozen
}

package() {
    cd "${srcdir}/proton-trainer-launcher-${pkgver}"

    install -Dm755 target/release/proton-trainer \
        "${pkgdir}/usr/bin/proton-trainer"

    install -Dm644 LICENSE \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    # Example trainer definitions ship with the package; the binary
    # resolves them from ../share relative to /usr/bin automatically.
    install -d "${pkgdir}/usr/share/proton-trainer/trainers"
    install -Dm644 trainers/*.toml \
        "${pkgdir}/usr/share/proton-trainer/trainers/"

    install -Dm644 README.md \
        "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
